# ==============================================================================
# zewito-order-service — Production & Staging Environment Template
# Microservice: Core Order Processing, Dispatch, Lifecycle & Realtime Tracking
# Port: 5050 | Stack: Node.js, Express, MongoDB, Socket.io, Redis
# Architected by: Er. Karan
# ==============================================================================

# ── Service Runtime ───────────────────────────────────────────────────────────
PORT=5050
NODE_ENV=production
API_VERSION=v1

# ── MongoDB Connection (Single Source of Truth: zewito-core-db) ────────────────
# Shared database with zewito-catalog-service on MongoDB Atlas cluster (zewito-prod-cluster)
ORDER_DB_URI=mongodb+srv://<username>:<password>@zewito-prod-cluster.xxxx.mongodb.net/zewito-core-db?retryWrites=true&w=majority&appName=zewito-prod-cluster

# Legacy fallback environment variable
MDB_URI=mongodb+srv://<username>:<password>@zewito-prod-cluster.xxxx.mongodb.net/zewito-core-db?retryWrites=true&w=majority&appName=zewito-prod-cluster

# ── Cryptographic Security & Authentication ───────────────────────────────────
# Master JWT secret for token verification
JWT_SECRET=your_production_jwt_secret_key_here

# Shared HMAC secret for /internal/v1/* inter-service communication (SHA-256)
INTERNAL_SERVICE_SECRET=d778a0a96422d9c1203f62e9753cbbb2fb9b175e41295e5a1d02ed0224152595

# ── Peer Microservice Endpoints (Cloud Production URLs) ───────────────────────
ORDER_SERVICE_URL=https://food-delivery-backend-api-n91v.onrender.com
CATALOG_SERVICE_URL=https://zewito-catalog-service.onrender.com
RIDER_SERVICE_URL=https://zewito-rider-service-5j83.onrender.com
LOGISTICS_SERVICE_URL=https://zewito-logistics-service-5r7w.onrender.com
AUTH_SERVICE_URL=https://zewito-auth-service.onrender.com
ADMIN_SERVICE_URL=https://zewito-admin-service.onrender.com
GATEWAY_URL=https://zewito-api-gateway.onrender.com

# ── Redis Geospatial Engine & Socket.io Adapter ───────────────────────────────
REDIS_URL=rediss://default:<password>@<redis-host>:<port>

# ── Ingress Security & CORS Allowlist (Dual-Environment: Local + Render) ─────
# In production, pass your Render Gateway domain:
ALLOWED_ORIGINS=https://zewito-api-gateway.onrender.com
FRONTEND_URL=https://zewito-api-gateway.onrender.com

# ── SMSCloud TRAI DLT OTP Gateway ─────────────────────────────────────────────
SMS_CLOUD_GATEWAY_URL=https://app.smscloud.in/pushapi/sendbulkmsg
SMS_CLOUD_USERNAME=KESHVACREDIT
SMS_CLOUD_SENDER_ID=CMTRA
SMS_CLOUD_TEMPLATE_ID=1707175922948829561
SMS_CLOUD_API_KEY=your_sms_cloud_api_key_here
